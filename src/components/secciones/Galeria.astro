---
import { Picture, getImage } from 'astro:assets';
import TituloAgua from '../TituloAgua.astro';
import Icono from '../Icono.astro';
import { titulos, galeria } from '../../data/fotos';

const filtros = [
  { id: 'todas', texto: 'Todas' },
  { id: 'dia', texto: 'Día' },
  { id: 'atardecer', texto: 'Atardecer' },
  { id: 'noche', texto: 'Noche' },
  { id: 'interior', texto: 'Interior' },
];

// íconos de línea propios para cada filtro (pathLength=1 para dibujarlos)
const iconos: Record<string, string> = {
  todas:
    '<rect class="c1" pathLength="1" x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect class="c2" pathLength="1" x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect class="c3" pathLength="1" x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect class="c4" pathLength="1" x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
  dia: '<circle pathLength="1" cx="12" cy="12" r="4"/><g class="rayos"><path pathLength="1" d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g>',
  atardecer:
    '<path pathLength="1" d="M2.5 17.5h19"/><g class="sol"><path pathLength="1" d="M6.5 17.5a5.5 5.5 0 0 1 11 0"/><path pathLength="1" d="M12 7v2.2M5.6 10.6l1.5 1.5M18.4 10.6l-1.5 1.5"/></g><path pathLength="1" d="M8 20.5h8"/>',
  noche:
    '<path pathLength="1" d="M18.5 14.6A7.5 7.5 0 1 1 9.4 5.5a6 6 0 0 0 9.1 9.1z"/><path class="estrella" d="M17.5 3.2l.55 1.35 1.35.55-1.35.55-.55 1.35-.55-1.35-1.35-.55 1.35-.55z"/>',
  interior:
    '<path pathLength="1" d="M4 11.2 12 4.5l8 6.7V20H4z"/><rect class="ventana" pathLength="1" x="9.5" y="12.5" width="5" height="4.5" rx="0.5"/>',
};

// estrellas de la noche: posiciones fijas (pseudoaleatorias) para que no cambien entre visitas
let semilla = 7;
const azar = () => ((semilla = (semilla * 9301 + 49297) % 233280) / 233280);
const estrellas = Array.from({ length: 46 }, () => ({
  x: (azar() * 100).toFixed(1),
  y: (azar() * 70).toFixed(1),
  t: (1 + azar() * 1.6).toFixed(1),
  d: (azar() * 4).toFixed(1),
}));

const fotos = await Promise.all(
  galeria.map(async (f) => {
    const grande = await getImage({ src: f.src, width: Math.min(1800, f.src.width), format: 'webp' });
    return { ...f, grande: grande.src, ratio: f.src.width / f.src.height };
  }),
);
---

<section
  id="galeria"
  class="seccion galeria"
  aria-labelledby="titulo-galeria"
  data-momento="atardecer"
  data-tono="oscuro"
>
  <TituloAgua foto={titulos.galeria} texto="Galería" id="titulo-galeria" alto="80svh" />

  <div class="seccion__cuerpo galeria__cuerpo" data-galeria>
    <div class="pista" data-pista>
    <div class="pista__ventana">
    <!-- el cielo de la galería cambia con el filtro elegido -->
    <div class="animo" aria-hidden="true" data-animo="todas">
      <span class="animo__capa animo__capa--dia"></span>
      <span class="animo__capa animo__capa--atardecer"></span>
      <span class="animo__capa animo__capa--noche">
        {estrellas.map((e) => <i style={`left:${e.x}%;top:${e.y}%;--t:${e.t}px;--d:${e.d}s`}></i>)}
      </span>
      <span class="animo__capa animo__capa--interior"></span>
    </div>
    <div class="marco galeria__barra">
      <div class="filtros" data-filtros>
        <div class="filtros__fila" role="group" aria-label="Filtrar fotos por momento del día">
          {
            filtros.map((f, i) => (
              <button type="button" class="filtro" aria-pressed={i === 0 ? 'true' : 'false'} data-filtro={f.id}>
                <svg class={`filtro__icono icono-${f.id}`} viewBox="0 0 24 24" aria-hidden="true" set:html={iconos[f.id]} />
                <span>{f.texto}</span>
              </button>
            ))
          }
        </div>
        <!-- copia del selector en colores "activos", recortada a la opción elegida -->
        <div class="filtros__fila filtros__activa" aria-hidden="true" data-activa>
          {
            filtros.map((f) => (
              <span class="filtro" data-en={f.id}>
                <svg class={`filtro__icono icono-${f.id}`} viewBox="0 0 24 24" set:html={iconos[f.id]} />
                <span>{f.texto}</span>
              </span>
            ))
          }
        </div>
      </div>
      <div class="galeria__nav">
        <button type="button" class="galeria__flecha" data-anterior aria-label="Fotos anteriores">
          <Icono nombre="flecha" />
        </button>
        <button type="button" class="galeria__flecha galeria__flecha--der" data-siguiente aria-label="Fotos siguientes">
          <Icono nombre="flecha" />
        </button>
      </div>
    </div>

    <p class="visually-hidden" aria-live="polite" data-conteo></p>

    <ul role="list" class="tira" data-tira tabindex="-1">
      {
        fotos.map((f, i) => (
          <li class="tira__item" data-momento={f.momento} style={`--r:${f.ratio.toFixed(3)}`}>
            <button type="button" class="tira__boton" data-abrir={i} data-grande={f.grande} data-alt={f.alt}>
              <span class="tira__marco">
                <Picture
                  src={f.src}
                  alt={f.alt}
                  formats={['avif', 'webp']}
                  widths={[400, 600, 800, 1000, 1300, 1600, 2000].filter((w) => w < f.src.width).concat(f.src.width)}
                  sizes={`(min-width: 900px) ${Math.round(Math.max(496, 620 * f.ratio) * 1.14)}px, ${Math.round(Math.max(78, 97.5 * f.ratio))}vw`}
                  quality={80}
                />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="marco pista__pie" aria-hidden="true">
      <span class="pista__progreso"><span data-progreso></span></span>
    </div>
    </div>
    </div>
  </div>


  <dialog class="visor" data-visor aria-label="Foto ampliada" data-tono="oscuro">
    <figure class="visor__figura">
      <img class="visor__foto" src={fotos[0].grande} alt={fotos[0].alt} data-visor-foto loading="lazy" decoding="async" />
      <figcaption class="visor__pie">
        <span data-visor-alt></span>
        <span class="visor__pos" data-visor-pos></span>
      </figcaption>
    </figure>
    <button type="button" class="visor__boton visor__cerrar" data-visor-cerrar aria-label="Cerrar">
      <Icono nombre="cerrar" tam={28} />
    </button>
    <button type="button" class="visor__boton visor__ant" data-visor-ant aria-label="Foto anterior">
      <Icono nombre="flecha" tam={28} />
    </button>
    <button type="button" class="visor__boton visor__sig" data-visor-sig aria-label="Foto siguiente">
      <Icono nombre="flecha" tam={28} />
    </button>
  </dialog>
</section>

<style>
  .galeria__barra {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    margin-bottom: var(--s-6);
  }

  /* selector: dos filas iguales; la de arriba (activa) se recorta a la opción elegida */
  .filtros {
    position: relative;
    min-width: 0;
    max-width: 100%;
    padding: 4px;
    border-radius: var(--r-pill);
    background: #1b2a25;
    border: 1px solid color-mix(in srgb, var(--agua) 40%, transparent);
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .filtros::-webkit-scrollbar {
    display: none;
  }

  .filtros__fila {
    display: flex;
    gap: 2px;
    width: max-content;
  }

  .filtro {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 16px 0 13px;
    border-radius: var(--r-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--bruma);
    white-space: nowrap;
  }

  .filtro__icono {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .filtros__fila:not(.filtros__activa) .filtro__icono {
    color: #9fb3ad;
  }

  .filtros__activa {
    position: absolute;
    top: 4px;
    left: 4px;
    background: var(--espuma);
    pointer-events: none;
    clip-path: inset(0 100% 0 0 round 999px);
    transition: clip-path 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filtros__activa .filtro {
    color: var(--noche);
  }

  .filtros__activa .filtro__icono {
    color: var(--embalse);
  }

  .filtros__activa .estrella,
  .filtros__activa .ventana {
    fill: currentColor;
  }

  .filtros__fila:not(.filtros__activa) .estrella {
    fill: currentColor;
  }

  /* ---------- el ícono de la opción elegida se dibuja ---------- */
  .filtros__activa .dibuja .filtro__icono :is(path, circle, rect) {
    stroke-dasharray: 1;
    animation: trazo 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .filtros__activa .dibuja .estrella {
    stroke-dasharray: none;
    animation: estrella-aparece 900ms cubic-bezier(0.16, 1, 0.3, 1) 350ms both;
    transform-box: fill-box;
    transform-origin: center;
  }

  .filtros__activa .dibuja .rayos {
    transform-box: fill-box;
    transform-origin: center;
    animation: rayos 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .filtros__activa .dibuja .sol {
    animation: sale-sol 1000ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .filtros__activa .dibuja .ventana {
    stroke-dasharray: none;
    animation: luz 900ms ease 450ms both;
  }

  .filtros__activa .dibuja :is(.c1, .c2, .c3, .c4) {
    stroke-dasharray: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: cuadro 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .filtros__activa .dibuja .c2 {
    animation-delay: 70ms;
  }
  .filtros__activa .dibuja .c3 {
    animation-delay: 140ms;
  }
  .filtros__activa .dibuja .c4 {
    animation-delay: 210ms;
  }

  @keyframes trazo {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes estrella-aparece {
    0% {
      transform: scale(0) rotate(-90deg);
      opacity: 0;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes rayos {
    from {
      transform: rotate(-70deg) scale(0.6);
      opacity: 0;
    }
  }

  @keyframes sale-sol {
    from {
      transform: translateY(5px);
      opacity: 0;
    }
  }

  @keyframes luz {
    from {
      fill-opacity: 0;
    }
    to {
      fill-opacity: 1;
    }
  }

  @keyframes cuadro {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  :global(html.suave) .filtros__activa {
    transition: none;
  }

  :global(html.suave) .filtros__activa .dibuja * {
    animation: none !important;
  }

  /* ---------- el cielo de la galería ---------- */
  .pista__ventana {
    position: relative;
  }

  .animo {
    position: absolute;
    inset: calc(var(--s-8) * -1) 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* sin bordes: el cielo se funde arriba y abajo con la sección */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }

  .animo__capa {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1100ms ease;
  }

  .animo__capa--dia {
    background:
      radial-gradient(90% 60% at 15% 0%, rgb(173 196 188 / 0.38), rgb(173 196 188 / 0) 70%),
      radial-gradient(70% 50% at 90% 15%, rgb(246 247 243 / 0.1), rgb(246 247 243 / 0) 70%);
  }

  .animo__capa--atardecer {
    background:
      radial-gradient(90% 65% at 85% 100%, rgb(232 164 95 / 0.38), rgb(232 164 95 / 0) 65%),
      radial-gradient(70% 50% at 10% 0%, rgb(140 91 54 / 0.35), rgb(140 91 54 / 0) 70%);
  }

  .animo__capa--noche {
    background: rgb(19 32 29 / 0.88);
  }

  .animo__capa--noche i {
    position: absolute;
    width: var(--t);
    height: var(--t);
    border-radius: 50%;
    background: var(--espuma);
    opacity: 0.2;
    animation: titila 3.2s ease-in-out var(--d) infinite alternate;
    animation-play-state: paused;
  }

  .animo[data-animo='noche'] .animo__capa--noche i {
    animation-play-state: running;
  }

  @keyframes titila {
    from {
      opacity: 0.15;
    }
    to {
      opacity: 0.85;
    }
  }

  .animo__capa--interior {
    background:
      radial-gradient(70% 55% at 50% 45%, rgb(140 91 54 / 0.5), rgb(140 91 54 / 0) 72%),
      radial-gradient(40% 30% at 50% 40%, rgb(232 164 95 / 0.14), rgb(232 164 95 / 0) 70%);
  }

  .animo[data-animo='dia'] .animo__capa--dia,
  .animo[data-animo='atardecer'] .animo__capa--atardecer,
  .animo[data-animo='noche'] .animo__capa--noche,
  .animo[data-animo='interior'] .animo__capa--interior {
    opacity: 1;
  }

  :global(html.suave) .animo__capa--noche i {
    animation: none;
    opacity: 0.5;
  }

  .tira,
  .pista__pie {
    position: relative;
    z-index: 1;
  }

  /* ---------- al cambiar de filtro: salen hacia el agua y entran desde el horizonte ---------- */
  :global(html.movido) .tira.sale .tira__item {
    opacity: 0 !important;
    transform: translateY(18px) !important;
    transition:
      opacity 220ms ease,
      transform 220ms ease !important;
    transition-delay: 0s !important;
  }

  :global(html.movido) .tira.entra .tira__item {
    animation: desde-horizonte 900ms cubic-bezier(0.76, 0, 0.18, 1) both;
    animation-delay: calc(var(--n, 0) * 75ms);
  }

  :global(html.movido) .tira.entra .tira__item :global(img) {
    animation: acerca-foto 1400ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--n, 0) * 75ms);
  }

  @keyframes desde-horizonte {
    from {
      clip-path: inset(50% 0 50% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes acerca-foto {
    from {
      scale: 1.25;
    }
    to {
      scale: 1;
    }
  }

  :global(html.suave) .tira.entra .tira__item,
  :global(html.suave) .tira.entra .tira__item :global(img) {
    animation: fundido-galeria 500ms ease both;
  }

  @keyframes fundido-galeria {
    from {
      opacity: 0;
    }
  }

  .galeria__nav {
    display: none;
    gap: var(--s-2);
  }

  .galeria__flecha {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-pill);
    border: 1px solid color-mix(in srgb, var(--bruma) 35%, transparent);
    color: var(--espuma);
    transition:
      transform var(--d-toque) var(--ease-out),
      opacity var(--d-corta) var(--ease-out);
  }

  .galeria__flecha:active {
    transform: scale(0.95);
  }

  .galeria__flecha:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .galeria__flecha--der :global(.icono) {
    transform: scaleX(-1);
  }

  @media (min-width: 900px) {
    .galeria__nav {
      display: flex;
    }
  }

  /* tira con scroll-snap */
  .tira {
    --alto: clamp(320px, 62vh, 620px);
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: 0 var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .tira::-webkit-scrollbar {
    display: none;
  }

  /* todas las fotos del mismo tamaño */
  .tira__item {
    flex: none;
    scroll-snap-align: start;
    height: var(--alto);
    aspect-ratio: 4 / 5;
  }

  .tira__item[hidden] {
    display: none;
  }

  .tira__boton {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--r-foto);
    overflow: hidden;
    cursor: zoom-in;
    transition: transform var(--d-toque) var(--ease-out);
  }

  .tira__boton:active {
    transform: scale(0.985);
  }

  /* la foto llena siempre su marco, sea vertical, cuadrada u horizontal */
  .tira__boton :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tira__boton :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .tira__item {
      height: auto;
      width: 78vw;
    }
  }

  /* visor */
  .visor {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(19 32 29 / 0.97);
    color: var(--bruma);
    overscroll-behavior: contain;
  }

  .visor::backdrop {
    background: transparent;
  }

  .visor[open] {
    display: grid;
    place-items: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .visor[open] {
      animation: visor-entra var(--d-visor) var(--ease-out);
    }
    .visor[open] .visor__foto {
      animation: foto-entra var(--d-visor) var(--ease-out);
    }
  }

  @keyframes visor-entra {
    from {
      opacity: 0;
    }
  }

  @keyframes foto-entra {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .visor__figura {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: 72px var(--gutter) calc(var(--s-7) + env(safe-area-inset-bottom));
    max-width: 100%;
    touch-action: pan-y;
  }

  .visor__foto {
    max-width: calc(100vw - 2 * var(--gutter));
    max-height: calc(100svh - 200px);
    width: auto;
    height: auto;
    border-radius: var(--r-foto);
    transition: opacity var(--d-corta) var(--ease-out);
  }

  .visor__pie {
    display: flex;
    gap: var(--s-5);
    justify-content: space-between;
    width: 100%;
    font-size: var(--t-detalle);
    max-width: 70ch;
  }

  .visor__pos {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--bruma) 75%, transparent);
  }

  .visor__boton {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--espuma);
    border-radius: var(--r-pill);
    transition: transform var(--d-toque) var(--ease-out);
  }

  .visor__boton:active {
    transform: scale(0.94);
  }

  .visor__cerrar {
    top: calc(var(--s-3) + env(safe-area-inset-top));
    right: calc(var(--gutter) - 10px);
  }

  .visor__ant,
  .visor__sig {
    top: 50%;
    margin-top: -24px;
  }

  .visor__ant {
    left: var(--s-2);
  }

  .visor__sig {
    right: var(--s-2);
  }

  .visor__sig :global(.icono) {
    transform: scaleX(-1);
  }

  @media (max-width: 899px) {
    .visor__ant,
    .visor__sig {
      display: none;
    }
  }
  /* ---------- pista: en desktop el scroll vertical mueve la tira ---------- */
  .tira__marco {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .pista__pie {
    margin-top: var(--s-6);
  }

  .pista__progreso {
    display: none;
    position: relative;
    height: 1px;
    background: color-mix(in srgb, var(--bruma) 22%, transparent);
    overflow: hidden;
  }

  .pista__progreso span {
    position: absolute;
    inset: 0;
    background: var(--espuma);
    transform: scaleX(var(--p, 0));
    transform-origin: 0 50%;
  }

  .pista.fija .pista__ventana {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .pista.fija .tira {
    overflow: visible;
    scroll-snap-type: none;
    transform: translate3d(var(--x, 0px), 0, 0);
    will-change: transform;
  }

  .pista.fija .tira__boton :global(img) {
    transform: scale(1.14);
  }

  .pista.fija .galeria__nav {
    display: none;
  }

  .pista.fija .pista__progreso {
    display: block;
  }

  /* las fotos entran desde la derecha cuando la galería aparece */
  :global(html.movido) .tira__item {
    opacity: 0;
    transform: translateX(80px);
    transition:
      opacity 1000ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 1400ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--n, 0) * 80ms);
  }

  :global(html.movido) .pista.visto .tira__item {
    opacity: 1;
    transform: none;
  }


  /* la miniatura se transforma en la foto ampliada */
  :global(::view-transition-group(foto-abierta)) {
    animation-duration: 650ms;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(::view-transition-old(foto-abierta)),
  :global(::view-transition-new(foto-abierta)) {
    animation: none;
    mix-blend-mode: normal;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-galeria]')!;
  const tira = raiz.querySelector<HTMLElement>('[data-tira]')!;
  const items = [...tira.querySelectorAll<HTMLLIElement>('.tira__item')];
  const filtros = [...raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const conteo = raiz.querySelector<HTMLElement>('[data-conteo]')!;
  const ant = raiz.querySelector<HTMLButtonElement>('[data-anterior]')!;
  const sig = raiz.querySelector<HTMLButtonElement>('[data-siguiente]')!;

  const nombres: Record<string, string> = {
    todas: 'todas las fotos',
    dia: 'fotos de día',
    atardecer: 'fotos de atardecer',
    noche: 'fotos de noche',
    interior: 'fotos del interior',
  };

  const reducir = matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- selector: la opción elegida se recorta sobre la copia "activa" ----------
  const caja = raiz.querySelector<HTMLElement>('[data-filtros]')!;
  const activa = raiz.querySelector<HTMLElement>('[data-activa]')!;
  const animo = raiz.querySelector<HTMLElement>('[data-animo]')!;
  let filtroActual = 'todas';

  function marcar(id: string, animar = true) {
    const b = filtros.find((x) => x.dataset.filtro === id)!;
    const w = activa.offsetWidth;
    const h = activa.offsetHeight;
    // el botón y su copia ocupan el mismo lugar; las medidas son relativas a la fila
    const l = b.offsetLeft - activa.offsetLeft;
    const t = b.offsetTop - activa.offsetTop;
    if (!animar) activa.style.transition = 'none';
    activa.style.clipPath = `inset(${t}px ${w - l - b.offsetWidth}px ${h - t - b.offsetHeight}px ${l}px round 999px)`;
    if (!animar) {
      void activa.offsetWidth;
      activa.style.transition = '';
      return;
    }
    const copia = activa.querySelector<HTMLElement>(`[data-en="${id}"]`)!;
    activa.querySelectorAll('.dibuja').forEach((x) => x.classList.remove('dibuja'));
    void copia.offsetWidth;
    copia.classList.add('dibuja');
    // en el celular, la opción elegida queda a la vista dentro del selector
    caja.scrollTo({
      left: b.offsetLeft - (caja.clientWidth - b.offsetWidth) / 2,
      behavior: reducir.matches ? 'instant' : 'smooth',
    } as ScrollToOptions);
  }

  function aplicar(id: string) {
    let n = 0;
    items.forEach((li) => {
      const ver = id === 'todas' || li.dataset.momento === id;
      li.hidden = !ver;
      if (ver) n++;
    });
    tira.scrollTo({ left: 0, behavior: 'instant' as ScrollBehavior });
    conteo.textContent = `${n} ${nombres[id]}`;
    numerar();
    medirPista();
    if (pista.classList.contains('fija')) {
      const top = pista.getBoundingClientRect().top + scrollY;
      if (scrollY > top) scrollTo({ top, behavior: 'instant' as ScrollBehavior });
    }
    flechas();
  }

  let espera = 0;
  function filtrar(id: string) {
    if (id === filtroActual) return;
    filtroActual = id;
    filtros.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === id)));
    marcar(id);
    animo.dataset.animo = id;
    if (!document.documentElement.classList.contains('movido')) {
      aplicar(id);
      return;
    }
    // las fotos actuales se hunden, cambian, y las nuevas se abren desde el horizonte
    clearTimeout(espera);
    tira.classList.remove('entra');
    tira.classList.add('sale');
    espera = window.setTimeout(() => {
      aplicar(id);
      tira.classList.remove('sale');
      void tira.offsetWidth;
      tira.classList.add('entra');
      espera = window.setTimeout(() => tira.classList.remove('entra'), 2200);
    }, 230);
  }
  filtros.forEach((b) => b.addEventListener('click', () => filtrar(b.dataset.filtro!)));
  // posición inicial del recorte, y de nuevo cuando cargan las fuentes o cambia el tamaño
  requestAnimationFrame(() => marcar(filtroActual, false));
  document.fonts?.ready.then(() => marcar(filtroActual, false));
  new ResizeObserver(() => marcar(filtroActual, false)).observe(caja);

  function mover(dir: 1 | -1) {
    tira.scrollBy({ left: dir * tira.clientWidth * 0.8, behavior: reducir.matches ? 'instant' : 'smooth' });
  }
  ant.addEventListener('click', () => mover(-1));
  sig.addEventListener('click', () => mover(1));
  function flechas() {
    ant.disabled = tira.scrollLeft <= 2;
    sig.disabled = tira.scrollLeft + tira.clientWidth >= tira.scrollWidth - 2;
  }
  tira.addEventListener('scroll', flechas, { passive: true });
  flechas();

  // visor
  const visor = document.querySelector<HTMLDialogElement>('[data-visor]')!;
  const foto = visor.querySelector<HTMLImageElement>('[data-visor-foto]')!;
  const alt = visor.querySelector<HTMLElement>('[data-visor-alt]')!;
  const pos = visor.querySelector<HTMLElement>('[data-visor-pos]')!;
  let lista: HTMLButtonElement[] = [];
  let actual = 0;
  let origen: HTMLButtonElement | null = null;

  function mostrar(i: number) {
    actual = (i + lista.length) % lista.length;
    const b = lista[actual];
    foto.src = b.dataset.grande!;
    foto.alt = b.dataset.alt!;
    alt.textContent = b.dataset.alt!;
    pos.textContent = `${actual + 1} de ${lista.length}`;
  }

  tira.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-abrir]');
    if (!b) return;
    lista = items.filter((li) => !li.hidden).map((li) => li.querySelector('button')!);
    origen = b;
    const mini = b.querySelector('img')!;
    const abrir = () => {
      mostrar(lista.indexOf(b));
      visor.showModal();
      document.documentElement.style.overflow = 'hidden';
    };
    const doc = document as Document & {
      startViewTransition?: (cb: () => void) => { finished: Promise<void> };
    };
    if (doc.startViewTransition && document.documentElement.classList.contains('movido')) {
      // la miniatura ya está cargada: se usa primero y después se cambia por la grande
      mini.style.viewTransitionName = 'foto-abierta';
      const vt = doc.startViewTransition(() => {
        mini.style.viewTransitionName = '';
        abrir();
        foto.src = mini.currentSrc;
        foto.style.viewTransitionName = 'foto-abierta';
      });
      vt.finished
        .catch(() => {})
        .finally(() => {
          foto.style.viewTransitionName = '';
          foto.src = b.dataset.grande!;
        });
    } else {
      abrir();
    }
  });

  visor.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    origen?.focus();
  });
  visor.querySelector('[data-visor-cerrar]')!.addEventListener('click', () => visor.close());
  visor.querySelector('[data-visor-ant]')!.addEventListener('click', () => mostrar(actual - 1));
  visor.querySelector('[data-visor-sig]')!.addEventListener('click', () => mostrar(actual + 1));
  visor.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') mostrar(actual - 1);
    if (e.key === 'ArrowRight') mostrar(actual + 1);
  });
  // tocar fuera de la foto cierra
  visor.addEventListener('click', (e) => {
    if (e.target === visor) visor.close();
  });

  // swipe horizontal en el visor
  let x0: number | null = null;
  let y0 = 0;
  visor.addEventListener('pointerdown', (e) => {
    if (e.pointerType === 'mouse') return;
    x0 = e.clientX;
    y0 = e.clientY;
  });
  visor.addEventListener('pointerup', (e) => {
    if (x0 == null) return;
    const dx = e.clientX - x0;
    const dy = e.clientY - y0;
    x0 = null;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) mostrar(actual + (dx < 0 ? 1 : -1));
  });
  // ---------- pista fija (desktop): el scroll vertical mueve la tira ----------
  const pista = raiz.querySelector<HTMLElement>('[data-pista]')!;
  const barraProgreso = raiz.querySelector<HTMLElement>('[data-progreso]')!;
  const movido = document.documentElement.classList.contains('movido');
  const ancho = matchMedia('(min-width: 900px)');
  let recorrido = 0;

  function numerar() {
    let n = 0;
    items.forEach((li) => {
      if (!li.hidden) li.style.setProperty('--n', String(n++));
    });
  }

  function moverPista() {
    if (!pista.classList.contains('fija')) return;
    const r = pista.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
    tira.style.setProperty('--x', `${(-p * recorrido).toFixed(1)}px`);
    barraProgreso.style.setProperty('--p', p.toFixed(4));
    const centro = innerWidth / 2;
    for (const li of items) {
      if (li.hidden) continue;
      const b = li.getBoundingClientRect();
      if (b.right < -200 || b.left > innerWidth + 200) continue;
      const d = (b.left + b.width / 2 - centro) / innerWidth;
      // se mueve la foto misma, sin pasar por una variable del padre
      li.querySelector<HTMLElement>('.tira__boton img')!.style.transform = `translate3d(${(-d * 60).toFixed(1)}px, 0, 0) scale(1.14)`;
    }
  }

  function medirPista() {
    const fija = movido && ancho.matches && !reducir.matches;
    pista.classList.toggle('fija', fija);
    if (!fija) {
      pista.style.height = '';
      tira.style.removeProperty('--x');
      tira.querySelectorAll<HTMLElement>('.tira__boton img').forEach((i) => (i.style.transform = ''));
      return;
    }
    const x = tira.style.getPropertyValue('--x');
    tira.style.setProperty('--x', '0px');
    recorrido = Math.max(0, tira.scrollWidth - innerWidth);
    tira.style.setProperty('--x', x || '0px');
    pista.style.height = `${innerHeight + recorrido * 0.8}px`;
    moverPista();
  }

  addEventListener('scroll', moverPista, { passive: true });
  addEventListener('resize', medirPista);
  ancho.addEventListener('change', medirPista);
  tira.addEventListener('load', medirPista, true);

  // con teclado: si el foco cae en una foto fuera de pantalla, llevar el scroll hasta ella
  tira.addEventListener('focusin', (e) => {
    if (!pista.classList.contains('fija')) return;
    const li = (e.target as HTMLElement).closest('li');
    if (!li) return;
    const objetivo = Math.min(recorrido, Math.max(0, li.offsetLeft - innerWidth * 0.3));
    const top = pista.getBoundingClientRect().top + scrollY + objetivo;
    scrollTo({ top, behavior: 'instant' as ScrollBehavior });
  });

  // aparición de las fotos
  numerar();
  if (movido) {
    new IntersectionObserver(
      ([x], obs) => {
        if (x.isIntersecting) {
          pista.classList.add('visto');
          obs.disconnect();
        }
      },
      { rootMargin: '0px 0px -20% 0px' },
    ).observe(pista);
  }

  medirPista();

</script>
