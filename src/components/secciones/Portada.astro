---
import TituloAgua from '../TituloAgua.astro';
import { titulos } from '../../data/fotos';
---

<section id="inicio" class="portada" aria-labelledby="titulo-portada" data-momento="manana" data-portada>
  <TituloAgua
    foto={titulos.portada}
    texto="Vive una experiencia sobre el agua"
    nivel="h1"
    id="titulo-portada"
    alto="var(--alto-portada)"
    portada
    grupos={['Vive una', 'experiencia', 'sobre el agua']}
  />
  <!-- en el celular la bajada y el botón van debajo de la foto, para no taparla;
       desde 720 px se apoyan sobre el agua, al pie de la foto -->
  <div class="portada__pie">
    <div class="marco portada__fila">
      <p class="portada__bajada">
        Casa flotante con jacuzzi privado en el embalse de Guatapé, pensada para dos. Te llevamos en lancha.
      </p>
      <a href="#reserva" class="boton portada__boton" data-iman>Ver fechas disponibles</a>
    </div>
    <span class="portada__bajar" aria-hidden="true"></span>
  </div>
</section>

<style>
  /* la foto de portada es horizontal: en el celular la escena es más baja
     para que se vea la casa entera y no solo la cabina */
  .portada {
    --alto-portada: max(440px, min(64svh, 128vw));
    position: relative;
  }

  /* en el celular el título es más chico para que la casa se vea */
  .portada :global(.agua__titulo--portada) {
    font-size: min(2.75rem, calc((100vw - 2 * var(--gutter)) / 6.2));
  }

  /* en el celular, el texto va en una franja Noche que continúa la foto */
  .portada__pie {
    position: relative;
    padding: var(--s-6) 0 var(--s-8);
    background: var(--noche);
    color: var(--bruma);
  }

  .portada__fila {
    position: relative;
    display: grid;
    gap: var(--s-5);
  }

  .portada__bajada {
    max-width: 36ch;
    font-size: var(--t-texto);
    line-height: 1.55;
  }

  /* reservar sobre fondo oscuro: Ocaso, como pide la propuesta */
  .portada__boton {
    --fondo: var(--ocaso);
    --tinta: var(--noche);
    --relleno: var(--espuma);
    width: 100%;
    min-height: 52px;
  }

  @media (min-width: 720px) {
    .portada {
      --alto-portada: 100svh;
    }

    .portada :global(.agua__titulo--portada) {
      font-size: min(var(--t-portada), calc((100vw - 2 * var(--gutter)) / 5.3));
    }

    .portada__pie {
      position: absolute;
      inset: auto 0 0;
      padding: 0 0 calc(var(--s-7) + env(safe-area-inset-bottom));
      background: none;
      color: var(--espuma);
    }

    /* legibilidad local del pie, sin teñir la foto */
    .portada__pie::before {
      content: '';
      position: absolute;
      inset: -40% 0 0;
      background: linear-gradient(to top, rgb(19 32 29 / 0.5), rgb(19 32 29 / 0));
      pointer-events: none;
    }

    .portada__fila {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    /* sobre la foto oscura, el botón de reservar va en Ocaso */
    .portada__boton {
      --fondo: var(--ocaso);
      --tinta: var(--noche);
      --relleno: var(--espuma);
      width: auto;
    }
  }

  :global(html.movido) .portada__fila > * {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 1000ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html.movido) .portada__fila > :nth-child(1) {
    transition-delay: 1700ms;
  }

  :global(html.movido) .portada__fila > :nth-child(2) {
    transition-delay: 1850ms;
  }

  :global(html.movido) .portada.visto .portada__fila > * {
    opacity: 1;
    transform: none;
  }

  :global(html.suave) .portada__fila > * {
    transform: none;
  }

  /* indicador de scroll: una gota que baja por un hilo */
  .portada__bajar {
    display: none;
  }

  @media (min-width: 720px) {
    .portada__bajar {
      display: block;
      position: absolute;
      left: 50%;
      bottom: var(--s-6);
      width: 1px;
      height: 56px;
      background: color-mix(in srgb, var(--espuma) 30%, transparent);
      overflow: hidden;
    }
    .portada__bajar::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 1px;
      height: 18px;
      background: var(--espuma);
      animation: gota 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
  }

  @keyframes gota {
    from {
      transform: translateY(-18px);
    }
    to {
      transform: translateY(56px);
    }
  }

  :global(html.suave) .portada__bajar::after {
    animation: none;
  }
</style>
