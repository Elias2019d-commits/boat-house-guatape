---
/**
 * Íconos propios: grilla de 24 px, trazo fino de 1,25 px, sin relleno.
 * Dibujados a partir de objetos reales de la casa.
 */
interface Props {
  nombre: keyof typeof trazos;
  tam?: number;
}

const trazos = {
  // lancha con estela
  lancha: '<path d="M3 13h15.5l2.5-3H14l-1.5-2.5H8L7 10H4.5"/><path d="M3 13l1.6 3.2c.3.5.8.8 1.4.8h11.3c.6 0 1.1-.3 1.4-.7L21 13"/><path d="M2.5 20c1.3 0 1.3-.8 2.6-.8s1.3.8 2.6.8 1.3-.8 2.6-.8 1.3.8 2.6.8 1.3-.8 2.6-.8 1.3.8 2.6.8 1.3-.8 2.6-.8"/>',
  // tina de madera con vapor
  jacuzzi: '<path d="M3.5 12.5h17v5.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"/><path d="M3.5 15.5h17M8 12.5V20M16 12.5V20"/><path d="M8.5 9.5c-.8-.9.8-1.6 0-2.5s.8-1.6 0-2.5M12 9.5c-.8-.9.8-1.6 0-2.5s.8-1.6 0-2.5M15.5 9.5c-.8-.9.8-1.6 0-2.5s.8-1.6 0-2.5"/>',
  // taza y pan
  desayuno: '<path d="M4 10.5h10v4.5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><path d="M14 12h1.5a2 2 0 0 1 0 4H14"/><path d="M7 7.5c-.6-.7.6-1.3 0-2M10.5 7.5c-.6-.7.6-1.3 0-2"/><path d="M17.5 19.5h3.5a1.2 1.2 0 0 0 0-2.4h-.4"/>',
  // kayak con remo
  kayak: '<path d="M2.5 14c3-1.8 6.2-2.5 9.5-2.5s6.5.7 9.5 2.5c-3 1.8-6.2 2.5-9.5 2.5S5.5 15.8 2.5 14z"/><path d="M9.5 14h5"/><path d="M5 20.5 19 6.5"/><path d="m19 6.5 1.2-2.7-2.7 1.2-.6 2.1zM5 20.5l-1.2 2.7"/>',
  // paddle board de pie
  paddle: '<path d="M12 2.5c2.2 2.6 3 6.2 3 9.5s-.8 6.9-3 9.5c-2.2-2.6-3-6.2-3-9.5s.8-6.9 3-9.5z"/><path d="M12 7v4"/><path d="M18.5 3v14.5M17 17.5h3l-1.5 3.5z"/>',
  // malla catamarán tensada
  malla: '<path d="M3 9.5h18M3 16.5h18"/><path d="M5 9.5 8 16.5M9 9.5l3 7M13 9.5l3 7M17 9.5l3 7"/><path d="M8 9.5 5 16.5M12 9.5l-3 7M16 9.5l-3 7M20 9.5l-3 7"/>',
  // parrilla
  bbq: '<path d="M4 10h16a8 8 0 0 1-16 0z"/><path d="M3 10h18"/><path d="M8.5 16.5 6.5 21M15.5 16.5l2 4.5"/><path d="M9 7c-.6-.7.6-1.3 0-2M12 7c-.6-.7.6-1.3 0-2M15 7c-.6-.7.6-1.3 0-2"/>',
  // olla
  cocina: '<path d="M5 10.5h14v6a3.5 3.5 0 0 1-3.5 3.5h-7A3.5 3.5 0 0 1 5 16.5z"/><path d="M3 10.5h18M2.5 13H5M19 13h2.5"/><path d="M9.5 10.5V9a2.5 2.5 0 0 1 5 0v1.5"/>',
  // pantalla con señal
  wifi: '<rect x="3" y="9.5" width="18" height="10" rx="1.5"/><path d="M9 22h6"/><path d="M8.5 5.5a5 5 0 0 1 7 0M10.4 7.4a2.3 2.3 0 0 1 3.2 0"/>',
  // parlante portátil
  parlante: '<rect x="3" y="7" width="18" height="10" rx="5"/><circle cx="8.5" cy="12" r="2.2"/><circle cx="15.5" cy="12" r="2.2"/><path d="M7 19.5h10"/>',
  // cama
  cama: '<path d="M3 18.5V7M21 18.5v-4.5a2 2 0 0 0-2-2H3"/><path d="M3 15.5h18"/><rect x="5" y="8.5" width="5" height="3.5" rx="1"/>',
  // mini-bar: botella y copa
  minibar: '<path d="M8 3h2v3.5c1.2.8 2 2 2 3.5v9.5a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 6 19.5V10c0-1.5.8-2.7 2-3.5z"/><path d="M6 13h6"/><path d="M15 9h5c0 2.6-1 4.5-2.5 4.5S15 11.6 15 9zM17.5 13.5V20M15.5 20h4"/>',
  // reloj (horarios)
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
  flecha: '<path d="M14.5 6 8.5 12l6 6"/>',
  cerrar: '<path d="M6 6l12 12M18 6 6 18"/>',
} as const;

const { nombre, tam = 24 } = Astro.props;
// pathLength=1 permite dibujar cada trazo con stroke-dashoffset
const svg = trazos[nombre].replace(/<(path|circle|rect) /g, '<$1 pathLength="1" ');
---

<svg
  class="icono"
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={svg}
/>
