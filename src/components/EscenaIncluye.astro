---
/**
 * Escenas en línea fina para los ítems de "Qué incluye" que no tienen foto real.
 * Todo se apoya en la línea del agua (y = 250) y se refleja debajo, como los títulos.
 * Las animaciones solo corren mientras la escena está a la vista (clase .arriba en el visor).
 */
interface Props {
  clave: 'lancha' | 'desayuno' | 'parlante';
}
const { clave } = Astro.props;
const id = `escena-${clave}`;
---

<svg class={`escena-svg escena-svg--${clave}`} viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-desvanece`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.9"></stop>
      <stop offset="0.55" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <mask id={`${id}-reflejo`} maskUnits="userSpaceOnUse" x="0" y="250" width="800" height="150">
      <rect x="0" y="250" width="800" height="150" fill={`url(#${id}-desvanece)`}></rect>
    </mask>
  </defs>

  <line class="e-horizonte" x1="0" y1="250" x2="800" y2="250"></line>

  {
    clave === 'lancha' && (
      <>
        <path class="e-fondo" d="M0 250 C120 206 220 214 300 232 S 460 202 560 226 S 720 238 800 222" />
        <g id={`${id}-dibujo`}>
          {/* la casa, a lo lejos: el destino */}
          <path class="e-casa" d="M600 250 V214 H664 V250 M592 214 H672 M608 214 V198 H652 V214 M624 198 V186 M624 186 L640 180" />
          <g class="e-bote">
            <path d="M0 250 L100 250 L116 233 L74 233 L66 218 L32 218 L27 233 L6 233 Z" />
            <path d="M38 226 H58" />
            <path class="e-estela" d="M-8 255 Q-44 260 -86 255" />
            <path class="e-estela e-estela--2" d="M-12 263 Q-62 270 -122 263" />
          </g>
        </g>
        <g class="e-reflejo" mask={`url(#${id}-reflejo)`}>
          <use href={`#${id}-dibujo`} transform="translate(0 500) scale(1 -1)" />
        </g>
        <path class="e-onda" d="M120 284 H164" />
        <path class="e-onda e-onda--2" d="M520 300 H580" />
        <path class="e-onda e-onda--3" d="M300 322 H336" />
      </>
    )
  }

  {
    clave === 'desayuno' && (
      <>
        <g id={`${id}-dibujo`}>
          {/* pan */}
          <path d="M226 250 C226 222 246 212 276 212 S 326 222 326 250 Z" />
          <path class="e-detalle" d="M252 228 L262 220 M272 230 L284 220 M294 232 L304 224" />
          {/* taza y plato */}
          <path d="M370 196 H470 V224 C470 240 454 250 436 250 H404 C386 250 370 240 370 224 Z" />
          <path d="M470 206 C496 206 496 238 470 238" />
          <path d="M346 250 H494" />
        </g>
        <g class="e-reflejo" mask={`url(#${id}-reflejo)`}>
          <use href={`#${id}-dibujo`} transform="translate(0 500) scale(1 -1)" />
        </g>
        {/* vapor que sube */}
        <path class="e-vapor" pathLength="1" d="M402 182 C392 168 412 158 402 144 S 412 120 402 106" />
        <path class="e-vapor e-vapor--2" pathLength="1" d="M422 186 C412 172 432 162 422 148 S 432 124 422 110" />
        <path class="e-vapor e-vapor--3" pathLength="1" d="M442 182 C432 168 452 158 442 144 S 452 120 442 106" />
        <path class="e-onda" d="M180 290 H220" />
        <path class="e-onda e-onda--2" d="M560 306 H612" />
      </>
    )
  }

  {
    clave === 'parlante' && (
      <>
        <g id={`${id}-dibujo`}>
          <rect x="330" y="196" width="140" height="54" rx="27" />
          <circle class="e-woofer" cx="374" cy="223" r="15" />
          <circle class="e-woofer e-woofer--2" cx="426" cy="223" r="15" />
          <circle cx="374" cy="223" r="5" />
          <circle cx="426" cy="223" r="5" />
        </g>
        <g class="e-reflejo" mask={`url(#${id}-reflejo)`}>
          <use href={`#${id}-dibujo`} transform="translate(0 500) scale(1 -1)" />
        </g>
        {/* ondas de sonido hacia los dos lados */}
        <path class="e-sonido" d="M492 206 Q508 223 492 240" />
        <path class="e-sonido e-sonido--2" d="M514 192 Q542 223 514 254" />
        <path class="e-sonido e-sonido--3" d="M536 178 Q578 223 536 268" />
        <path class="e-sonido e-sonido--izq" d="M308 206 Q292 223 308 240" />
        <path class="e-sonido e-sonido--izq e-sonido--2" d="M286 192 Q258 223 286 254" />
        <path class="e-sonido e-sonido--izq e-sonido--3" d="M264 178 Q222 223 264 268" />
        <path class="e-onda" d="M160 292 H200" />
        <path class="e-onda e-onda--2" d="M600 304 H650" />
      </>
    )
  }
</svg>

<style>
  .escena-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(70% 60% at 50% 62%, color-mix(in srgb, var(--agua) 35%, var(--embalse)), var(--embalse));
    fill: none;
    stroke: var(--espuma);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .escena-svg :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .e-horizonte {
    stroke-opacity: 0.55;
  }

  .e-fondo,
  .e-detalle {
    stroke-opacity: 0.4;
  }

  .e-casa {
    stroke-opacity: 0.7;
  }

  .e-reflejo {
    opacity: 0.35;
  }

  .e-onda {
    stroke-opacity: 0.35;
  }

  /* ---------- movimiento (pausado salvo en la escena visible) ---------- */
  .escena-svg :global(*) {
    animation-play-state: paused;
  }

  :global(.arriba) > .escena-svg :global(*) {
    animation-play-state: running;
  }

  .e-bote {
    animation: navega 9s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  @keyframes navega {
    0% {
      transform: translateX(-150px);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    78% {
      transform: translateX(450px);
      opacity: 1;
    }
    90%,
    100% {
      transform: translateX(462px);
      opacity: 0;
    }
  }

  .e-estela {
    stroke-opacity: 0.5;
    stroke-dasharray: 10 14;
    animation: estela 1.2s linear infinite;
  }

  .e-estela--2 {
    animation-duration: 1.6s;
  }

  @keyframes estela {
    to {
      stroke-dashoffset: 24;
    }
  }

  .e-onda {
    animation: ondula 4.5s ease-in-out infinite alternate;
  }

  .e-onda--2 {
    animation-delay: -1.5s;
  }

  .e-onda--3 {
    animation-delay: -3s;
  }

  @keyframes ondula {
    from {
      transform: translateX(-14px);
    }
    to {
      transform: translateX(14px);
    }
  }

  .e-vapor {
    stroke-opacity: 0.8;
    stroke-dasharray: 0.5 1;
    animation: vapor 3s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .e-vapor--2 {
    animation-delay: 0.7s;
  }

  .e-vapor--3 {
    animation-delay: 1.4s;
  }

  @keyframes vapor {
    0% {
      stroke-dashoffset: 0.5;
      transform: translateY(10px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -1;
      transform: translateY(-18px);
      opacity: 0;
    }
  }

  .e-woofer {
    transform-box: fill-box;
    transform-origin: center;
    animation: late 0.46s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .e-woofer--2 {
    animation-delay: 0.23s;
  }

  @keyframes late {
    0% {
      transform: scale(1.12);
    }
    100% {
      transform: scale(1);
    }
  }

  .e-sonido {
    opacity: 0;
    animation: sonido 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .e-sonido--2 {
    animation-delay: 0.3s;
  }

  .e-sonido--3 {
    animation-delay: 0.6s;
  }

  .e-sonido--izq {
    --dir: -1;
  }

  @keyframes sonido {
    0% {
      opacity: 0;
      transform: translateX(calc(var(--dir, 1) * -10px));
    }
    25% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translateX(calc(var(--dir, 1) * 14px));
    }
  }

  /* quieto: cada escena se ve completa, sin movimiento */
  @media (prefers-reduced-motion: reduce) {
    .escena-svg :global(*) {
      animation: none !important;
    }
    .e-sonido {
      opacity: 0.7;
    }
    .e-vapor {
      stroke-dasharray: none;
      opacity: 0.8;
    }
    .e-bote {
      transform: translateX(300px);
    }
  }
</style>
